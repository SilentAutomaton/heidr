# Copy to .env or export these from your shell profile.
# Only needed when the configured provider talks to a hosted service.

# Name matches llm.api_key_env in config.toml
HEIDR_LLM_KEY=

# Used only when stt.provider = "api"
HEIDR_STT_KEY=

# Both needed by the twitch_voice source, and by nothing else.
# Register an application at dev.twitch.tv to get them.
HEIDR_TWITCH_ID=
HEIDR_TWITCH_SECRET=

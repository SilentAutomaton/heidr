Screen {
    background: $surface;
    layers: back front;
    align: center middle;
}

#visual {
    layer: back;
    width: 100%;
    height: 100%;
    color: $accent;
    overflow: hidden;
}

#visual > * {
    height: 100%;
    width: 100%;
}

/* The panel floats in the middle of the animation and grows with what it
   holds, up to the size of the terminal. It must never fill the screen: what
   it covers, it hides. */
#body {
    layer: front;
    width: auto;
    height: auto;
    max-width: 90%;
    max-height: 100%;
    padding: 1 2;
    background: $surface;
    color: $text;
    overflow: hidden;
}

#chrome {
    layer: front;
    dock: bottom;
    height: 2;
}

StatusLine {
    height: 1;
    background: $primary-darken-2;
    color: $text;
    padding: 0 1;
}

CommandLine {
    height: 1;
    background: $surface;
    color: $text-muted;
    padding: 0 1;
}

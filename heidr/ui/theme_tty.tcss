/* The bare Linux console gives eight colours and no dim text worth relying on,
   so this theme uses no shades: all text is the terminal's own colour. */

Screen {
    background: ansi_default;
    color: ansi_default;
    layers: back front;
    align: center middle;
    overflow: hidden;
}

#visual {
    layer: back;
    width: 100%;
    height: 100%;
    /* The status and command lines cover the last two rows; an animation
       drawn under them would lose its ground line. */
    margin-bottom: 2;
    overflow: hidden;
}

#visual > * {
    height: 100%;
    width: 100%;
}

#body {
    layer: front;
    width: auto;
    height: auto;
    max-width: 90%;
    max-height: 100%;
    padding: 1 2;
    overflow: hidden;
}

#chrome {
    layer: front;
    dock: bottom;
    height: 2;
}

StatusLine {
    height: 1;
    padding: 0 1;
}

CommandLine {
    height: 1;
    padding: 0 1;
}

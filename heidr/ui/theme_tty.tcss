/* The bare Linux console gives eight colours and no dim text worth relying on,
   so this theme uses reversed video instead of shades. */

Screen {
    background: black;
    color: white;
    layers: back front;
    align: center middle;
}

#visual {
    layer: back;
    width: 100%;
    height: 100%;
    color: white;
    overflow: hidden;
}

#visual > * {
    height: 100%;
    width: 100%;
}

#body {
    layer: front;
    width: auto;
    height: auto;
    max-width: 90%;
    max-height: 100%;
    padding: 1 2;
    background: black;
    color: white;
    overflow: hidden;
}

#chrome {
    layer: front;
    dock: bottom;
    height: 2;
}

StatusLine {
    height: 1;
    background: white;
    color: black;
    padding: 0 1;
}

CommandLine {
    height: 1;
    background: black;
    color: white;
    padding: 0 1;
}
